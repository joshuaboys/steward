{
  "name": "steward",
  "main": "apps/ingress-worker/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "STEWARDS",
        "class_name": "RepoSteward"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoSteward"]
    }
  ],
  "workflows": [
    {
      "name": "steward-run",
      "binding": "STEWARD_RUN_WORKFLOW",
      "class_name": "StewardRunWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "steward-evidence"
    }
  ]
}
