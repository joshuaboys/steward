{
  "name": "steward",
  "private": true,
  "bin": {
    "steward": "./bin/steward.mjs"
  },
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-strip-types --test src/steward/steward.test.ts src/steward/cli/cli.test.ts src/steward/cli/package-root.test.ts src/steward/cli/install.test.ts",
    "proof": "node --experimental-strip-types scripts/proof.mjs",
    "worker": "node bin/steward.mjs worker",
    "deploy": "node bin/steward.mjs deploy",
    "steward": "node bin/steward.mjs",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
